{
  "name": "@keepur/hive-plugins-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Default plugin registry for Hive — monorepo root (not published)",
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -b packages/*",
    "clean": "rm -rf packages/*/dist packages/*/tsconfig.tsbuildinfo"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^22.0.0"
  },
  "engines": { "node": ">=22" }
}
